FORGE_API_URL=http://127.0.0.1:8000
# Agent Relay. FORGE_RELAY_URL picks the engine: unset or loopback runs the local Relaycast
# engine; https://cast.agentrelay.com uses hosted Agent Relay. On the hosted engine Forge
# mints an anonymous workspace unless FORGE_RELAY_WORKSPACE_KEY (rk_live_...) names yours;
# with a key and no URL, the hosted engine is assumed. A key you provide is never saved.
FORGE_RELAY_URL=
FORGE_RELAY_WORKSPACE_KEY=
FORGE_RELAY_BRIDGE=http://127.0.0.1:7529
# Optional Supabase private artifact mirror. Never expose the service key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Model-backed research agents. With a key, all five roles reason with a model
# and can spin up subagents; without one, the deterministic local director runs as before.
OPENAI_API_KEY=
FORGE_DIRECTOR_MODEL=gpt-5-mini
# Optional: one model for the whole team, or per role (DIRECTOR, DATA, TRAINER, EVALUATOR, GOVERNANCE).
FORGE_AGENT_MODEL=
FORGE_AGENT_MODEL_GOVERNANCE=
# Subagent limits: at most this many at once, this many levels deep, this many model calls per decision.
FORGE_AGENT_MAX_SUBAGENTS=4
FORGE_AGENT_DEPTH=2
FORGE_AGENT_MAX_CALLS=12
# Optional: a Freestyle (freestyle.sh) VM per research agent, for the run_python tool.
FREESTYLE_API_KEY=
# FORGE_AGENT_VMS=0 turns VMs off with the key set. Runs per agent and seconds per run:
FORGE_VM_RUNS_PER_AGENT=3
FORGE_VM_RUN_SECONDS=60
# Azure uses its OpenAI-compatible v1 endpoint and a deployed model name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Optional absolute directory when restoring an existing local Terse runtime.
FORGE_TERSE_DATA_DIR=
# Production overseer. Deployments post traces to the Supabase `ingest` edge function (uses the
# SUPABASE_* values above on the lab side); the lab pulls every FORGE_OVERSEER_SECONDS (0 = off).
FORGE_OVERSEER_SECONDS=60
# Optional judge for a sample of traces: any OpenAI-compatible endpoint ending in /v1.
FORGE_OVERSEER_JUDGE_URL=
FORGE_OVERSEER_JUDGE_MODEL=
# Name of the variable that holds the judge's API key (the key itself goes in that variable).
FORGE_OVERSEER_JUDGE_KEY_ENV=
# A hosted judge sees production text only after this is set to 1.
FORGE_OVERSEER_SEND_TRACES=
FORGE_OVERSEER_SAMPLE_RATE=0.02
FORGE_OVERSEER_DAILY_USD=1.00
FORGE_OVERSEER_DAILY_CALLS=200
FORGE_OVERSEER_PRICE_IN_PER_M=0
FORGE_OVERSEER_PRICE_OUT_PER_M=0
FORGE_OVERSEER_LATENCY_SLO_MS=
# Hephaestus, the iMessage group chat bot. The chat id comes from
# `python -m services.core.hephaestus chats`, or any;-;<you> to message yourself. The owner is admin;
# operators may start and stop training. Its private conversation in Agent chat needs none of this.
FORGE_HEPHAESTUS_CHAT=
FORGE_HEPHAESTUS_OWNER=
FORGE_HEPHAESTUS_OPERATORS=
# Its own model connection, separate from the research agents' (e.g. a friend's Azure deployment).
# Unset, it shares theirs and uses FORGE_AGENT_MODEL_HEPHAESTUS, then FORGE_AGENT_MODEL.
FORGE_HEPHAESTUS_AZURE_ENDPOINT=
FORGE_HEPHAESTUS_AZURE_KEY=
FORGE_HEPHAESTUS_AZURE_MODEL=
FORGE_AGENT_MODEL_HEPHAESTUS=
# The most Hephaestus can give one agent's decision, however it's asked.
FORGE_AGENT_CEILING_SUBAGENTS=8
FORGE_AGENT_CEILING_DEPTH=3
FORGE_AGENT_CEILING_CALLS=40
FORGE_HEPHAESTUS_DAILY_CAMPAIGNS=3
FORGE_HEPHAESTUS_DAILY_CALLS=200
FORGE_HEPHAESTUS_DAILY_TOKENS=2000000
# Missions: most wake-ups for one mission, and the shortest gap between them.
FORGE_HEPHAESTUS_MISSION_WAKES=24
FORGE_HEPHAESTUS_WAKE_SECONDS=60
FORGE_HEPHAESTUS_MAX_SECONDS=1800
FORGE_HEPHAESTUS_MIN_FREE_MEMORY=35
# Its own VM (uses SUPERSERVE_API_KEY). It holds no credentials and can reach only these hosts.
FORGE_HEPHAESTUS_VM_ALLOW=
FORGE_HEPHAESTUS_VM_ACTIVE_SECONDS=1800
FORGE_HEPHAESTUS_VM_RETAIN_SECONDS=1209600
FORGE_HEPHAESTUS_VM_DAILY_COMMANDS=200
# Connected traffic. With SUPERSERVE_API_KEY and the Supabase values above, each connection's agent
# gets its own VM; otherwise it runs as a process on this machine.
SUPERSERVE_API_KEY=
FORGE_OVERSEER_MAX_VMS=3
# VMs auto-pause after this long unless the lab resumes them, so billing stops if the lab goes away.
FORGE_OVERSEER_VM_ACTIVE_SECONDS=3600
FORGE_OVERSEER_VM_RETAIN_SECONDS=604800
# Optional override for where VMs post traces (default: <SUPABASE_URL>/functions/v1/ingest).
FORGE_OVERSEER_INGEST_URL=
